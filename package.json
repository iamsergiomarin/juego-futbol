{
  "name": "juego-futbol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "calibrar": "tsx scripts/calibrar.ts",
    "typecheck": "tsc --noEmit",
    "migraciones": "tsx scripts/generar-migraciones.ts",
    "prebuild": "tsx scripts/generar-migraciones.ts",
    "build:servidor": "npm run migraciones && next build && node scripts/preparar-escritorio.mjs",
    "escritorio": "npm run build:servidor && electron desktop",
    "dist:windows": "npm run build:servidor && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.iamsergiomarin.juegofutbol",
    "productName": "Manager de Futbol",
    "electronVersion": "45.0.0",
    "directories": {
      "app": "desktop",
      "output": "dist-escritorio"
    },
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "servidor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "servidor/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Manager-de-Futbol-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Mánager de fútbol"
    }
  }
}
